#!/bin/sh
set -eu
export LC_ALL=C

runtime=${XDG_RUNTIME_DIR:?}/wob-volume-${WAYLAND_DISPLAY:?}
exec 9>"$runtime.control.lock"
flock 9

case ${1:-} in
    up) wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ ;;
    down) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
    mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
    *) exit 2 ;;
esac

state=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)
value=$(printf '%s\n' "$state" | awk '
    /MUTED/ { print 0; next }
    { n = int($2 * 100 + 0.5); print (n > 100 ? 100 : n < 0 ? 0 : n) }
')

# Volume keys must still work if the OSD is not running.
if [ -p "$runtime.fifo" ]; then
    timeout 0.2 sh -c 'printf "%s\n" "$1" > "$2"' sh "$value" "$runtime.fifo" || :
fi
