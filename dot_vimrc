" ddc.vim
call ddc#custom#patch_global({
    \ 'ui': 'pum',
    \ 'autoCompleteEvents': [
    \   'InsertEnter', 'TextChangedI', 'TextChangedP', 'CmdlineChanged',
    \ ],
    \ 'cmdlineSources': {
    \   ':': ['cmdline', 'cmdline_history', 'around'],
    \   '/': ['around', 'line'],
    \   '?': ['around', 'line'],
    \ },
    \})
call ddc#custom#patch_global('sources', ['around', 'file', 'cmdline', 'buffer'])
call ddc#custom#patch_global('filterParams', {
    \ 'matcher_fuzzy': {
    \   'splitMode': 'word'
    \ }
    \ })
call ddc#custom#patch_global('sourceParams', {
    \ 'around': {
    \   'maxSize': 500,
    \ },
    \ })
call ddc#custom#patch_filetype(['vim'], 'sources', ['around', 'necovim', 'file', 'buffer'])
call ddc#custom#patch_global('sourceOptions', {
	\ '_': {
	\ 	'matchers': ['matcher_fuzzy'],
	\ 	'sorters': ['sorter_fuzzy'],
    \   'converters': ['converter_remove_overlap', 'converter_fuzzy'],
	\ },
    \ 'around': {
    \   'mark': 'around',
    \ },
	\ 'file': {
    \   'mark': 'file',
	\	'isVolatile': v:true,
	\	'forceCompletionPattern': '\S/\S*',
	\ },
    \ 'necovim': {'mark': 'vim'},
    \ 'cmdline': {
    \   'mark': 'cmdline',
    \   'maxItems': 15,
    \ },
    \ 'cmdline_history': {
    \   'mark': 'history',
    \ },
    \ 'line': {
    \   'mark': 'line'
    \ }
	\ })
call ddc#enable()

inoremap <C-n> <Cmd>call pum#map#select_relative(+1)<CR>
inoremap <C-p> <Cmd>call pum#map#select_relative(-1)<CR>
inoremap <C-y> <Cmd>call pum#map#confirm()<CR>
inoremap <C-e> <Cmd>call pum#map#cancel()<CR>

nnoremap : <Cmd>call CommandlinePre()<CR>:
function! CommandlinePre() abort
    cnoremap <C-n> <Cmd>call pum#map#insert_relative(+1)<CR>
    cnoremap <C-p> <Cmd>call pum#map#insert_relative(-1)<CR>
    cnoremap <C-y> <Cmd>call pum#map#confirm()<CR>
    cnoremap <C-e> <Cmd>call pum#map#cancel()<CR>

    autocmd User DDCCmdlineLeave ++once call CommandlinePost()

    call ddc#enable_cmdline_completion()
endfunction
function! CommandlinePost() abort
    silent! cunmap <C-n>
    silent! cunmap <C-p>
    silent! cunmap <C-y>
    silent! cunmap <C-e>
endfunction

call pum#set_option({
    \ 'border': 'single',
    \ })

" ddt.vim
call ddt#custom#patch_global({
    \ 'ui': 'terminal',
    \ 'uiParams': {
    \   'terminal': {
    \       'command': ['zsh'],
    \       'promptPattern': '\w*% \?',
    \           'split': 'vertical',
    \   },
    \   'shell': {
    \       'prompt': '=\\\>',
    \       'promptPattern': '\w*=\\\>\?',
    \   },
    \ },
    \ })
autocmd FileType ddt-shell call s:ddt_my_settings()
function! s:ddt_my_settings() abort
  nnoremap <buffer> <C-n>
        \ <Cmd>call ddt#ui#do_action('nextPrompt')<CR>
  nnoremap <buffer> <C-p>
        \ <Cmd>call ddt#ui#do_action('previousPrompt')<CR>
  nnoremap <buffer> <C-y>
        \ <Cmd>call ddt#ui#do_action('pastePrompt')<CR>
  nnoremap <buffer> <CR>
        \ <Cmd>call ddt#ui#do_action('executeLine')<CR>
  nnoremap <buffer> <leader>n
      \ <Cmd>call ddt#ui#do_action('send', #{
      \   str: 'git status',
      \ })<CR>
endfunction
