" ===== OPTIONS =====
syntax on
colorscheme iceberg

set cursorline

set scrolloff=5

set signcolumn=yes

set wildoptions+=pum

" search
set incsearch
set nohlsearch

set ignorecase
set smartcase
set wrapscan

" edit
set smarttab
set expandtab
set shiftwidth=4
set tabstop=4
set shiftround
set autoindent autoindent

set matchpairs+=<:>

let &grepprg='rg --vimgrep'

" history
augroup histclean
  autocmd!
  autocmd ModeChanged c:* call s:HistClean()
augroup END

function! s:HistClean() abort
  let cmd = histget(":", -1)
  if cmd == "x" || cmd == "xa" || cmd =~# "^w\\?q\\?a\\?!\\?$"
    call histdel(":", -1)
  endif
endfunction

" ===== KEYMAPS =====
let g:mapleader=","

inoremap <silent> jj <ESC>
nnoremap <F2> <Cmd>noh<CR>

nnoremap j gj
nnoremap k gk


" ===== PLUGIN OPTIONS  =====

